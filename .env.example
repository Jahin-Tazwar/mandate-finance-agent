# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# --- API server ---
PORT=4000
# Folder with the seed CSV files (the app's "database"), relative to the repo root
SEED_DIR=data/seed

# --- Auth (from Oct 15) ---
# Long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Required for POST /api/admin/reset when set (always set it on the hosted version)
ADMIN_KEY=
# TEMPORARY: true lets requests without a session through, so the web app keeps working
# until it has its sign-in screen. Signed-in users are still checked; PINs still required.
# Remove it (or set false) as soon as the sign-in screen ships.
AUTH_DISABLED=

# --- LLM via OpenRouter (needed for chat) ---
# Without these, chat answers "The AI assistant isn't set up yet". Tests never use them.
OPENROUTER_API_KEY=
# Pick models that support tool calling (openrouter.ai/models, filter "tools")
LLM_MODEL=
LLM_FALLBACK_MODEL=
# DEVELOPMENT ONLY: true lets providers that may keep/train on prompts answer, which most
# free models (ids ending in :free) need. Leave it empty for the demo and use paid models,
# so the privacy promise holds ("only providers that don't keep our data").
# Free models that worked with tools on Oct 16: nvidia/nemotron-3-super-120b-a12b:free,
# poolside/laguna-s-2.1:free
LLM_ALLOW_PROVIDER_TRAINING=

# --- On-chain anchoring (stretch, testnet only, NEVER a real wallet) ---
RPC_URL=
ANCHOR_PRIVATE_KEY=
